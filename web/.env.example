# Public deployment mode
NEXT_PUBLIC_CAREER_OPS_MODE=community
NEXT_PUBLIC_COMMUNITY_NAME=The Commons
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_COMMUNITY_DAILY_TOKEN_LIMIT=20000

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Legacy fallbacks remain supported during migration:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Server-only HMAC salt for login throttling (generate at least 32 random bytes).
COMMUNITY_RATE_LIMIT_SECRET=

# Hosted fit checks (server-only). Set the provider to grok to use xAI.
CAREER_OPS_AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1
COMMUNITY_MAX_OUTPUT_TOKENS=700

# Used only for the displayed cost estimate; update when model pricing changes.
OPENAI_INPUT_USD_PER_MTOK=0.20
OPENAI_OUTPUT_USD_PER_MTOK=1.20
XAI_INPUT_USD_PER_MTOK=2.00
XAI_OUTPUT_USD_PER_MTOK=6.00
